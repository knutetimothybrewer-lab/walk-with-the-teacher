{
  "objectives": {
    "FL1.1": {
      "text": "Identify the major structures of the male and female reproductive systems.",
      "basis": "district"
    },
    "FL1.2": {
      "text": "Explain the functions of key reproductive organs (ovaries, testes, uterus, fallopian tubes), including ovulation.",
      "basis": "district"
    },
    "FL1.3": {
      "text": "Differentiate between methods of contraception: barrier, hormonal, and sterilization.",
      "basis": "district"
    },
    "FL1.4": {
      "text": "Describe the basic stages of pregnancy from conception to birth.",
      "basis": "district"
    },
    "FL2.1": {
      "text": "Define key terms related to family life and sexuality.",
      "basis": "district"
    },
    "FL2.2": {
      "text": "Identify factors that contribute to healthy family dynamics.",
      "basis": "district"
    },
    "FL2.3": {
      "text": "Analyze the impact of communication on family relationships.",
      "basis": "district"
    },
    "FL2.4": {
      "text": "Evaluate the importance of consent and healthy boundaries in relationships.",
      "basis": "district"
    },
    "FL3.1": {
      "text": "Identify and explain effective HIV prevention strategies.",
      "basis": "district"
    },
    "FL3.2": {
      "text": "Describe the advantages of practicing abstinence as a method of HIV prevention.",
      "basis": "district"
    },
    "FL3.3": {
      "text": "Evaluate the effectiveness of abstinence compared to other prevention strategies.",
      "basis": "district"
    },
    "FL3.4": {
      "text": "Apply knowledge of prevention strategies to real-life scenarios involving HIV risk.",
      "basis": "district"
    },
    "STD3": {
      "text": "Standard 3: access information, products, and services to enhance health.",
      "basis": "standard"
    },
    "STD4": {
      "text": "Standard 4: use interpersonal communication skills (including refusal and boundary-setting) to enhance health and avoid or reduce health risks.",
      "basis": "standard"
    },
    "STD5": {
      "text": "Standard 5: use decision-making skills to enhance health.",
      "basis": "standard"
    },
    "STD8": {
      "text": "Standard 8: advocate for personal, family, and community health.",
      "basis": "standard"
    },
    "BP1": {
      "text": "Describe the range of typical variation in the timing of puberty, and tell evidence-based statements from myths and values.",
      "basis": "blueprint"
    },
    "BP2": {
      "text": "Distinguish healthy, unhealthy, and controlling behaviors in relationships (text-thread analysis).",
      "basis": "blueprint"
    },
    "BP3": {
      "text": "Classify common STIs by cause and treatment, and explain why symptoms alone cannot show whether someone has an STI.",
      "basis": "blueprint"
    },
    "BP4": {
      "text": "Interpret data shown in a chart.",
      "basis": "blueprint"
    },
    "BP5": {
      "text": "Evaluate whether a health information source is credible.",
      "basis": "blueprint"
    },
    "BP6": {
      "text": "Integrate misinformation analysis, relationship dynamics, consent, the decision model, and resources in one case.",
      "basis": "blueprint"
    }
  },
