{
  "name": "wildcat-wellness-trail",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive, self-grading mental health unit assessment (static site; no build step required).",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.js",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=900000 tests/e2e/e2e.test.js",
    "timing": "node tools/timing.js",
    "audit": "node tools/audit.js",
    "map": "node tools/content-map.js",
    "build": "node tools/build.js"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "lighthouse": "^13.5.0",
    "playwright": "1.56.1"
  }
}
