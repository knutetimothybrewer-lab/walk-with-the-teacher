{
  "name": "riverton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Riverton: a community health studio (City, Crossroads, Sim Lab).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && SINGLE=1 vite build",
    "test": "vitest run",
    "validate-content": "tsx tools/validate-content.ts",
    "shots": "node tools/screenshots.mjs",
    "a11y": "node tools/a11y.mjs",
    "sizes": "node tools/sizes.mjs",
    "e2e": "for t in e2e e2e-lab e2e-xr e2e-city e2e-wrap; do node tools/$t.mjs || exit 1; done"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
