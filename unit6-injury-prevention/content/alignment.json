{
  "objectives": {
    "M1-DATA": {
      "text": "Read injury and belt-use data (NHES 3) to compare rates and explain that injury is predictable, not random.",
      "basis": "standard"
    },
    "M1-MECH": {
      "text": "Explain how seat belts and helmets reduce injury by spreading force and lengthening stopping time (NHES 1).",
      "basis": "standard"
    },
    "M1-MYTH": {
      "text": "Correct common seat belt myths with accurate facts (NHES 1).",
      "basis": "standard"
    },
    "M2-RECOG": {
      "text": "Tell cardiac arrest from a heart attack and recognize the signs of cardiac arrest (NHES 1).",
      "basis": "standard"
    },
    "M2-CHAIN": {
      "text": "Put the Chain of Survival links in order (NHES 1).",
      "basis": "standard"
    },
    "M2-TECH": {
      "text": "Read compression rate from a trace and judge technique (NHES 7).",
      "basis": "standard"
    },
    "M2-SCOPE": {
      "text": "Choose hands-only CPR or CPR with breaths for the situation, and know the C-A-B order (NHES 1, 7).",
      "basis": "standard"
    },
    "M2-AED": {
      "text": "Put the steps of AED use in order (NHES 7).",
      "basis": "standard"
    },
    "M3-MYTH": {
      "text": "Match common organ-donation myths with accurate facts (NHES 8).",
      "basis": "standard"
    },
    "M3-MSG": {
      "text": "Choose an accurate, respectful message that corrects a myth (NHES 8).",
      "basis": "standard"
    },
    "M3-CHECK": {
      "text": "Judge which statements about donation are myths (NHES 8, 3).",
      "basis": "standard"
    },
    "M4-PLAN": {
      "text": "Plan a home fire escape: alarms, two ways out and an outside meeting spot (NHES 7).",
      "basis": "standard"
    },
    "M4-FIRE": {
      "text": "Respond to a fire: get low, close doors, never go back, and know the extinguisher classes and when to fight a fire (NHES 7).",
      "basis": "standard"
    },
    "M4-AID": {
      "text": "Decide between treating a minor cut or burn yourself and getting help (NHES 7).",
      "basis": "standard"
    }
  },
