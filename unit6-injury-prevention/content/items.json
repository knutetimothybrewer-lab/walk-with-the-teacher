              "secs": 60,
              "unlockAfter": null,
              "options": [
                {
                  "id": "od2a87",
                  "text": "Drowning ranked second among these three causes for this age group."
                },
                {
                  "id": "o5547b",
                  "text": "Drowning deaths happened at nearly the same rate as poisoning deaths."
                },
                {
                  "id": "o9c692",
                  "text": "Poisoning deaths happened at about twice the motor vehicle traffic rate."
                },
                {
                  "id": "oe04c5",
                  "text": "Motor vehicle traffic deaths happened at about six times the drowning rate."
                },
                {
                  "id": "obfc73",
                  "text": "Motor vehicle traffic deaths happened at about three times the poisoning rate."
                }
              ]
            }
