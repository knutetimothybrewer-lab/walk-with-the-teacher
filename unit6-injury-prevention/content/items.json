              ],
              "secs": 60,
              "unlockAfter": null,
              "steps": [
                {
                  "id": "sc0479",
                  "text": "Call 911 so help is on the way"
                },
                {
                  "id": "s70d30",
                  "text": "Recognize that the person is in cardiac arrest"
                },
                {
                  "id": "s7f6f6",
                  "text": "Hand the person over to EMS when they arrive"
                },
                {
                  "id": "sad258",
                  "text": "Start chest compressions right away"
                },
