      "n": 1,
      "title": "Predictable, Not Random",
      "theme": "lab",
      "intro": "Injuries follow patterns, and patterns can be studied. Run the crash lab, explore the belt-use data, then show what you learned.",
      "targetMinutes": 11,
      "units": [
