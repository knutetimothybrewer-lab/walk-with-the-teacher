    {
      "id": "m2",
      "n": 2,
      "title": "Chain of Survival",
      "theme": "medlab",
      "intro": "Seconds matter when a heart stops. Practice a calm, correct response in three different emergencies and with an AED, then show what you know.",
      "targetMinutes": 14,
      "units": [
        {
          "id": "m2-u1",
          "title": "Heart attack or cardiac arrest?",
          "intro": null,
          "stimulus": [
            {
              "t": "sim",
              "id": "rescue",
              "title": "Rescue practice",
              "lead": "Handle three emergencies and one AED. You choose what to do and in what order. The scene reacts to what you do.",
              "chips": [
                {
                  "id": "adult",
                  "label": "Finish the adult collapse scene"
                },
                {
                  "id": "drowning",
                  "label": "Finish the drowning scene"
                },
                {
                  "id": "infant",
                  "label": "Finish the infant scene"
                },
                {
                  "id": "aed",
                  "label": "Complete one AED shock cycle"
                }
              ]
            },
            {
              "t": "p",
              "text": "Two different heart emergencies can look alike from far away. An emergency card at a school nurse’s office lists six descriptions."
            }
          ],
          "gate": [
            "adult",
            "drowning",
            "infant",
            "aed"
          ],
          "readSecs": 480,
          "items": [
            {
              "id": "M2-01",
              "type": "assign",
              "topic": "Cardiac arrest versus heart attack",
              "prompt": "Sort each description under the problem it best describes.",
              "points": 5,
              "cog": "understand",
              "obj": [
                "M2-RECOG"
              ],
              "secs": 70,
              "unlockAfter": null,
              "assign": {
                "mode": "classify",
                "fill": "cards",
                "figure": null,
                "layout": null,
                "pick": null,
                "cards": [
                  {
                    "id": "c110fa",
                    "text": "The heart’s electrical signal goes wrong and the heart stops pumping blood."
                  },
                  {
                    "id": "c0ce50",
                    "text": "The person suddenly collapses, does not respond and is not breathing normally."
                  },
                  {
                    "id": "caf193",
                    "text": "A blocked artery cuts blood flow to part of the heart muscle."
                  },
                  {
                    "id": "cf51d3",
                    "text": "The person is awake and says the chest feels tight or heavy."
                  },
                  {
                    "id": "ca23b4",
                    "text": "Rescuers need to start CPR and use an AED without waiting."
                  },
                  {
                    "id": "cc48cb",
                    "text": "Symptoms may build slowly while the person is still talking."
                  }
                ],
                "targets": [
                  {
                    "id": "g794b2",
                    "label": "Cardiac arrest"
                  },
                  {
                    "id": "gb4a5e",
                    "label": "Heart attack"
                  }
                ]
              }
            }
          ]
        },
